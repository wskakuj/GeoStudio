rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin manages these documents in Firebase Console via IAM.
    // A client may only read its own ACTIVE and non-expired entitlement.
    match /geostudio_access/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid
        && resource.data.active == true
        && (resource.data.expiresAt == null
            || (resource.data.expiresAt is timestamp
                && request.time < resource.data.expiresAt));
      allow list, create, update, delete: if false;
    }
  }
}
